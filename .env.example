# =============================================================================
# Variables d'environnement — voir docs/01-ARCHITECTURE.md §6
#
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# `.env.local` est ignoré par git et NE DOIT JAMAIS être versionné.
#
# Règle de sécurité : tout ce qui n'est pas préfixé NEXT_PUBLIC_ reste serveur.
# Une clé secrète préfixée NEXT_PUBLIC_ finit dans le bundle navigateur.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne la RLS. Server Actions, route handlers et crons UNIQUEMENT.
SUPABASE_SERVICE_ROLE_KEY=

# --- ImageKit ----------------------------------------------------------------
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/xxxxx
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# --- Stripe ------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signature des webhooks — sans elle, une commande peut être marquée payée à tort.
STRIPE_WEBHOOK_SECRET=

# --- Resend (emails transactionnels) -----------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=commandes@exemple.fr
# ⚠️ SPF, DKIM et DMARC doivent être configurés sur le domaine avant l'ouverture,
# sinon les confirmations de commande partent en spam et le tunnel est cassé.

# --- SMS (lot 2) -------------------------------------------------------------
SMS_PROVIDER_API_KEY=

# --- Calcul des distances routières (secteur de livraison) -------------------
# Instance OSRM utilisée pour mesurer la distance dépôt → commune (docs/02 §2.1).
# Par défaut : le serveur public de démonstration, gratuit mais sans engagement
# de service. À remplacer par une instance dédiée si le volume le justifie ;
# en cas d'échec, le scan retombe sur une estimation signalée à l'exploitant.
ROUTAGE_OSRM_URL=https://router.project-osrm.org

# --- Divers ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Protège /api/cron/* — les crons Vercel doivent présenter ce secret.
CRON_SECRET=
SENTRY_DSN=
# Avis Google + autocomplétion d'adresse (l'API Adresse gouvernementale est
# gratuite et sans clé : à privilégier pour l'autocomplétion).
GOOGLE_PLACES_API_KEY=
